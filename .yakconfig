[cells]
root = .
prelude = prelude
toolchains = toolchains

[cell_aliases]
config = prelude

[external_cells]
prelude = bundled

[buildfile]
name = YAK

[build]
execution_platforms = prelude//platforms:default

[parser]
target_platform_detector_spec = target:root//...->prelude//platforms:default

[project]
ignore = \
    examples, \
    tests, \
    .jj, \
    .git, \
    target
