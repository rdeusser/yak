# Matches Windows when `-c cxx.windows_compiler_type=clang` selects clang-cl.
# The default is MSVC.
config_setting(
    name = "windows-clang",
    constraint_values = ["prelude//os/constraints:windows"],
    values = {"cxx.windows_compiler_type": "clang"},
)

system_cxx_toolchain(
    name = "cxx",
    compiler = select({
        "DEFAULT": "gcc",
        "prelude//os:windows": None,
        ":windows-clang": "clang-cl",
    }),
    # `compiler_type = "gcc"` is required in addition to the compiler
    # binary names. The prelude gates many flags on `compiler_type`
    # rather than the binary name (e.g. `prelude/cxx/compiler.bzl` adds
    # `-Xclang -fdebug-compilation-dir ... -fcolor-diagnostics` only when
    # `compiler_type in ["clang", ...]`). Without this, gcc is invoked
    # with clang-only flags and rejects them.
    compiler_type = select({
        "DEFAULT": "gcc",
        "prelude//os:windows": "windows",
        ":windows-clang": "clang_cl",
    }),
    cxx_compiler = select({
        "DEFAULT": "g++",
        "prelude//os:windows": None,
    }),
    cxx_flags = select({
        "DEFAULT": ["-std=c++20"],
        "prelude//os:windows": ["/std:c++20", "/EHsc"],
        ":windows-clang": ["/std:c++20", "/EHsc"],
    }),
    # Linking with `g++` makes `prelude/toolchains/cxx.bzl` leave out its
    # `-fuse-ld=lld` flag, so the build needs neither clang nor lld.
    linker = select({
        "DEFAULT": "g++",
        "prelude//os:windows": None,
    }),
    visibility = ["PUBLIC"],
)

# The prelude's default C++ toolchain dependency names this target in a select
# branch that no configuration matches (`prelude/decls/toolchains_common.bzl`).
# Unconfigured queries such as `yak uquery 'deps(//:yak)'` visit every
# branch and fail on a missing target.
alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

