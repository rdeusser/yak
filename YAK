load("@crates//:workspace.bzl", "cargo_workspace")
load(":defs.bzl", "yak_bundle")

cargo_workspace()

# The client binary next to the daemon binary, the layout that the
# client-only build expects. `yak.py` runs it.
yak_bundle(
    name = "yak_bundle",
    yak = "//app/yak:yak",
    yak_client = "//app/yak:yak_client-bin",
    visibility = ["PUBLIC"],
)
