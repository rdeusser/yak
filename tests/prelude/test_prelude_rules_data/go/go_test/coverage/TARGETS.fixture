load("//:py_assertion.bzl", "py_assertion")

prelude = native

prelude.go_test(
    name = "test",
    srcs = [
        "coverage.go",
        "coverage_test.go",
    ],
    coverage_mode = "set",
)

py_assertion(
    name = "check_coverage",
    script = """
import subprocess
import sys
result = subprocess.check_output([sys.argv[1]], stderr=subprocess.STDOUT, text=True)
assert "coverage: 100.0% of statements in go/go_test/coverage" in result
""",
    script_args = ["$(location_exec :test)"],
)
