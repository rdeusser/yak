load("@prelude//cfg/modifier:yakconfig_backed_modifiers.bzl", "YakconfigBackedModifier", "yakconfig_backed_modifiers")
load("//:defs.bzl", "labeled_dummy")

# The yakconfig-backed modifier rule that injects yakconfig_backed:enabled
# as a post_platform_modifier. This modifier should apply to target configurations
# but NOT to exec dep configurations.
yakconfig_backed_modifiers(
    name = "yakconfig_modifiers",
    pre_platform = [],
    post_platform = [
        YakconfigBackedModifier(
            section = "test",
            property = "enable_yakconfig_backed",
            value = True,
            modifiers = ["//cfg:yakconfig_backed[enabled]"],
        ),
    ],
    pre_cli = [],
)

# A simple tool - this is used as an exec_dep
# When configured as exec_dep, it should NOT get yakconfig_backed:enabled from yakconfig-backed modifiers
labeled_dummy(
    name = "simple_tool",
)

# A binary that uses the tool as exec_dep
# The binary SHOULD get yakconfig_backed:enabled from yakconfig-backed modifiers
# The tool (exec_dep) should NOT get yakconfig_backed:enabled
labeled_dummy(
    name = "binary_with_yakconfig_modifier",
    # set a modifier to ensure that the yakconfig-backed modifier is applied
    modifiers = ["root//cfg:compiler[clang]"],
    exec_deps = [":simple_tool"],
    default_target_platform = "root//cfg:debug_platform",
)
