kotlin_library(
    name = "per_test_coverage_base",
    srcs = [
        "BasePerTestCoverageRunListener.kt",
        "PerTestCoverageExtension.kt",
        "PerTestCoverageExtensionManager.kt",
    ],
    # Uses kotlin_library (not buck_kotlin_library) with kotlin-stdlib in provided_deps: its
    # consumers already package kotlin-stdlib, and shipping ours too breaks Android APK D8 dexing
    # with duplicate types. Keep the bootstrap Kotlin toolchain in sync with buck_kotlin_library so tests
    # that override the Java compiler mode don't analyze this target with mismatched Kotlin/Java
    # compiler modes. The source also hand-rolls JSON instead of using jackson-core for the same
    # reason.
    _kotlin_toolchain = "toolchains//:kotlin_bootstrap",
    provided_deps = [
        "prelude//toolchains/android/third-party:kotlin-stdlib",
    ],
    source = "11",
    target = "11",
    tests = [
        "prelude//toolchains/android/test/dev/yak/testrunner:per_test_coverage_base_test",
    ],
    visibility = [
        "prelude//toolchains/android/src/dev/yak/testrunner:junit",
        "prelude//toolchains/android/test/dev/yak/testrunner:per_test_coverage_base_test",
        "prelude//toolchains/android/test/dev/yak/testrunner:per_test_coverage_listener_test",
    ],
    deps = [
        "prelude//toolchains/android/third-party:junit",
    ],
)

