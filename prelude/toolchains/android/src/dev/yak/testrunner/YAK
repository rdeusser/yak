    name = "testrunner-bin-fixed",
    out = "testrunner-bin-fixed.jar",
    entries_to_exclude = [
        "^(?!dev/yak/|META-INF/services/org.junit.jupiter|com/fasterxml/jackson/core|kotlin/).*",
    ],
    visibility = [
        "PUBLIC",
    ],
    zip_srcs = [
        ":testrunner-bin",
    ],
)

