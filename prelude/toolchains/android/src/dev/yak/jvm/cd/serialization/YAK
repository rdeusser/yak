load("@prelude//toolchains/android/tools:build_rules.bzl", "buck_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

buck_java_library(
    name = "serialization",
    srcs = glob(
        ["*.java"],
        exclude = ["SerializationUtil.java"],
    ),
    visibility = [
        "prelude//toolchains/android/src/dev/yak/jvm/...",
        "prelude//toolchains/android/test/dev/yak/jvm/...",
    ],
    deps = [
        "prelude//toolchains/android/src/dev/yak/cd/resources/proto:cd-model",
        "prelude//toolchains/android/src/dev/yak/core/filesystems:filesystems",
        "prelude//toolchains/android/src/dev/yak/io/filesystem:filesystem",
        "prelude//toolchains/android/src/dev/yak/util/environment:environment",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
    ],
)

buck_java_library(
    name = "util",
    srcs = ["SerializationUtil.java"],
    visibility = [
        "prelude//toolchains/android/src/dev/yak/jvm/cd/serialization/...",
    ],
    deps = [
        "prelude//toolchains/android/third-party:infer-annotations",
    ],
)
