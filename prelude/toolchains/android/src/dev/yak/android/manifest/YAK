load("@prelude//toolchains/android/tools:build_rules.bzl", "SIGNED_JAR_BLOCKLIST", "buck_java_binary", "buck_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

buck_java_library(
    name = "manifest",
    srcs = glob(["*.java"]),
    visibility = [
        "prelude//toolchains/android/src/dev/yak/android/...",
        "prelude//toolchains/android/test/dev/yak/...",
    ],
    deps = [
        "prelude//toolchains/android/src/dev/yak/android:manifest_utils",
        "prelude//toolchains/android/src/dev/yak/android/apkmodule:module-only",
        "prelude//toolchains/android/src/dev/yak/util:throwing_print_writer",
        "prelude//toolchains/android/src/dev/yak/util/environment:platform",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        "prelude//toolchains/android/third-party:manifest-merger",
        "prelude//toolchains/android/third-party:tools-sdk-common",
    ],
)

buck_java_binary(
    name = "generate_manifest_binary",
    blocklist = SIGNED_JAR_BLOCKLIST,
    main_class = "dev.yak.android.manifest.GenerateManifestExecutableMain",
    visibility = ["PUBLIC"],
    deps = [
        ":manifest",
    ],
)

buck_java_binary(
    name = "replace_application_id_placeholders_binary",
    blocklist = SIGNED_JAR_BLOCKLIST,
    main_class = "dev.yak.android.manifest.ReplaceApplicationIdPlaceholdersExecutableMain",
    visibility = ["PUBLIC"],
    deps = [
        ":manifest",
    ],
)
