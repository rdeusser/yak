load("@prelude//toolchains/android/tools:build_rules.bzl", "buck_java_binary", "buck_java_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

buck_java_library(
    name = "aar_builder",
    srcs = glob(["*.java"]),
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/dev/yak/core/filesystems:filesystems",
        "prelude//toolchains/android/src/dev/yak/features/zip/rules/utils:utils",
        "prelude//toolchains/android/src/dev/yak/util/relativepathmap:relativepathmap",
        "prelude//toolchains/android/src/dev/yak/util/zip/collect:collect",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
)

buck_java_binary(
    name = "aar_builder_binary",
    main_class = "dev.yak.android.aar.AarBuilderExecutableMain",
    visibility = ["PUBLIC"],
    deps = [
        ":aar_builder",
    ],
)
