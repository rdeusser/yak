load("@prelude//toolchains/android/tools:build_rules.bzl", "buck_java_binary", "buck_java_library", "buck_kotlin_library")
load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

APK_MODULE_ONLY = [
    "APKModule.kt",
]

BINARY_SRCS = ["APKModuleGraphExecutableMain.java"]

buck_kotlin_library(
    name = "module-only",
    srcs = APK_MODULE_ONLY,
    tests = [
        "prelude//toolchains/android/test/dev/yak/android/apkmodule:apkmodule",
    ],
    visibility = ["PUBLIC"],
    deps = [],
    exported_deps = [],
)

buck_java_library(
    name = "apkmodule",
    srcs = glob(
        ["*.java"],
        exclude = APK_MODULE_ONLY + BINARY_SRCS,
    ),
    tests = [
        "prelude//toolchains/android/test/dev/yak/android/apkmodule:apkmodule",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/dev/yak/core/util/graph:graph",
        "prelude//toolchains/android/src/dev/yak/io/filesystem:filesystem",
        "prelude//toolchains/android/src/dev/yak/jvm/java/classes:classes",
        "prelude//toolchains/android/src/dev/yak/util:util",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
    ],
    exported_deps = [
        ":module-only",
    ],
)

buck_java_library(
    name = "apkmodule-binary-lib",
    srcs = BINARY_SRCS,
    tests = [
        "prelude//toolchains/android/test/dev/yak/android/apkmodule:apkmodule",
    ],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//toolchains/android/src/dev/yak/core/filesystems:filesystems",
        "prelude//toolchains/android/src/dev/yak/io/file:file",
        "prelude//toolchains/android/src/dev/yak/util/json:json",
        "prelude//toolchains/android/third-party:args4j",
        "prelude//toolchains/android/third-party:guava",
        "prelude//toolchains/android/third-party:infer-annotations",
        "prelude//toolchains/android/third-party:kotlin-annotations",
        ":apkmodule",
    ],
)

buck_java_binary(
    name = "apkmodule_binary",
    main_class = "dev.yak.android.apkmodule.APKModuleGraphExecutableMain",
    visibility = [
        "PUBLIC",
    ],
    deps = [
        ":apkmodule-binary-lib",
    ],
)
