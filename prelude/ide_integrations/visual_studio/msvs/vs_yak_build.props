<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
      Overrides for default VS targets which allow building a project with yak instead of MSBuild.
  -->
  <PropertyGroup>
      <vs_yak_path>yak</vs_yak_path>
      <vs_yak_build_command>$(vs_yak_path) $(ImmediateYakOptions) build @$(YakModeFile) $(YakConfig) $(YakTarget)</vs_yak_build_command>
  </PropertyGroup>
  <Target Name="Build">
      <Exec WorkingDirectory="$(RepoRoot)" Command="$(vs_yak_build_command) $(ExtraYakOptions)"/>
  </Target>
  <Target Name="Clean">
    <Exec WorkingDirectory="$(RepoRoot)" Command="yak clean @$(YakModeFile)"/>
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build"/>
  <PropertyGroup>
    <LocalDebuggerCommand Condition="'$(LocalDebuggerCommand)'=='$(TargetPath)'">$(YakDebuggerCommand)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory Condition="'$(YakDebuggerCommandWorkingDirectory)' != ''">$(YakDebuggerCommandWorkingDirectory)</LocalDebuggerWorkingDirectory>
    <LocalDebuggerCommandArguments>$(YakDebuggerCommandArguments) $(LocalDebuggerCommandArguments)</LocalDebuggerCommandArguments>
    <LocalDebuggerEnvironment>$(YakDebuggerEnvironment)
$(LocalDebuggerEnvironment)</LocalDebuggerEnvironment>
    <!-- Allows test discovery and probably other things to work too -->
    <TargetPath Condition="'$(YakDebuggerCommand)'!=''">$(YakDebuggerCommand)</TargetPath>
  </PropertyGroup>
</Project>
