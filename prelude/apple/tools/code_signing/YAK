load("@prelude//utils:source_listing.bzl", "source_listing")

source_listing()

configured_alias(
    name = "dummy_binary_for_signing_configured",
    actual = ":dummy_binary_for_signing",
    platform = ":dummy_binary_for_signing_platform",
)

platform(
    name = "dummy_binary_for_signing_platform",
    constraint_values = [
        "config//cpu/constraints:arm64",
        "config//os/constraints:macos",
    ],
)

cxx_binary(
    name = "dummy_binary_for_signing",
    srcs = ["dummy_binary_for_signing.c"],
    default_target_platform = ":dummy_binary_for_signing_platform",
)

python_library(
    name = "apple_platform_lib",
    srcs = ["apple_platform.py"],
    visibility = ["PUBLIC"],
)

python_library(
    name = "serialization",
    srcs = ["serialization.py"],
    typing = True,
    visibility = ["PUBLIC"],
)

python_library(
    name = "lib",
    srcs = glob(
        [
            "*.py",
        ],
        exclude = [
            "*_test.py",
            "main.py",
            "apple_platform.py",
            "serialization.py",
        ],
    ),
    resources = [":dummy_binary_for_signing_configured"],
    visibility = ["PUBLIC"],
    deps = [
        "prelude//apple/tools:plistlib_utils",
        "prelude//apple/tools/info_plist_processor:process",
        ":apple_platform_lib",
        ":serialization",
    ],
)

python_test(
    name = "tests",
    srcs = glob(["*_test.py"]),
    resources = glob([
        "test_resources/*",
    ]),
    deps = [
        ":lib",
    ],
)

python_binary(
    name = "codesign_bundle",
    main = "main.py",
    visibility = ["PUBLIC"],
    deps = [
        ":lib",
    ],
)
