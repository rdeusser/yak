load("//build_defs:rust.bzl", "rust_binary")

rust_binary(
    name = "benchmark_memory",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    crate_root = "src/main.rs",
    deps = [
        "//starlark-rust/starlark:starlark",
        "//starlark-rust/starlark_syntax:starlark_syntax",
        "//third-party/rust:clap",
    ] + select({
        "DEFAULT": [],
        "prelude//os:linux": [
            "//third-party/rust:libc",
        ],
    }),
)
