load("//build_defs:rust.bzl", "rust_binary")

rust_binary(
    name = "starlark_bin",
    srcs = glob(
        ["bin/**/*.rs"],
    ),
    crate_root = "bin/main.rs",
    env = {"CARGO_PKG_VERSION": "0.0"},  # `--version` reads CARGO_PKG_VERSION, which only Cargo sets.
    deps = [
        "//gazebo/dupe:dupe",
        "//starlark-rust/starlark:starlark",
        "//starlark-rust/starlark_lsp:starlark_lsp",
        "//third-party/rust:anyhow",
        "//third-party/rust:argfile",
        "//third-party/rust:clap",
        "//third-party/rust:debugserver-types",
        "//third-party/rust:either",
        "//third-party/rust:globset",
        "//third-party/rust:itertools",
        "//third-party/rust:lsp-types",
        "//third-party/rust:serde",
        "//third-party/rust:serde_json",
        "//third-party/rust:thiserror",
        "//third-party/rust:tower-lsp-server",
        "//third-party/rust:walkdir",
    ],
)
