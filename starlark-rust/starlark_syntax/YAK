load("//build_defs:rust.bzl", "rust_library")

filegroup(
    name = "testcases",
    srcs = glob([
        "src/**/*.golden",
        "testcases/**",
    ]),
    visibility = ["PUBLIC"],
)

rust_library(
    name = "starlark_syntax",
    srcs = glob(["src/**/*.rs"]),
    rustc_flags = [
        "--cfg=rust_nightly",
    ],
    visibility = [
        # Code outside `starlark-rust` uses the `starlark` crate, which has the
        # public API. A feature that works with the syntax tree, like a linter,
        # belongs in the `starlark` crate.
        "//starlark-rust/...",
        # For faster incremental compilation of yak,
        # we pull `starlark::Error` from this crate rather than from `starlark`.
        "//app/yak_error/...",
    ],
    deps = [
        "//allocative/allocative:allocative",
        "//gazebo/dupe:dupe",
        "//pagable:pagable",
        "//starlark-rust/starlark_map:starlark_map",
        "//third-party/rust:annotate-snippets",
        "//third-party/rust:anyhow",
        "//third-party/rust:derivative",
        "//third-party/rust:derive_more",
        "//third-party/rust:logos",
        "//third-party/rust:lsp-types",
        "//third-party/rust:memchr",
        "//third-party/rust:num-bigint",
        "//third-party/rust:num-traits",
        "//third-party/rust:strum",
        "//third-party/rust:thiserror",
    ],
)
