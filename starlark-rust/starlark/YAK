load("//build_defs:rust.bzl", "rust_library")

# Constraint controlling the "pagable" Cargo feature of the starlark crate.
# When enabled, pagable serialization/deserialization support for starlark values is enabled.
# `//:yak` sets it to "enabled" with a transition (`defs.bzl`). Other targets get "disabled".
constraint(
    name = "pagable",
    default = "disabled",
    execution_modifier = True,
    values = [
        "enabled",
        "disabled",
    ],
    visibility = ["PUBLIC"],
)

alias(
    name = "starlark-bin",
    actual = "//starlark-rust/starlark_bin:starlark_bin",
    visibility = ["PUBLIC"],
)

filegroup(
    name = "testcases",
    srcs = glob([
        "src/**/golden/**",
        "src/**/*.golden",
        "testcases/**",
    ]),
    copy = False,
    visibility = ["PUBLIC"],
)

rust_library(
    name = "starlark",
    srcs = glob(["src/**/*.rs"]),
    # `pagable` controls type registration for starlark values which shouldn't be enforced everywhere.
    # `pagable_dep` controls whether to depend on pagable at all, so the published crate builds with stable rustc.
    features = select({
        ":pagable[enabled]": [
            "pagable",
            "pagable_dep",
        ],
        "DEFAULT": ["pagable_dep"],
    }),
    rustc_flags = [
        "--cfg=rust_nightly",
    ] + select({
        ":pagable[enabled]": ["--cfg=starlark_require_heap_names"],
        "DEFAULT": [],
    }),
    deps = [
        "//allocative/allocative:allocative",
        "//gazebo/cmp_any:cmp_any",
        "//gazebo/display_container:display_container",
        "//gazebo/dupe:dupe",
        "//gazebo/strong_hash:strong_hash",
        "//pagable:pagable",
        "//starlark-rust/starlark_derive:starlark_derive",
        "//starlark-rust/starlark_map:starlark_map",
        "//starlark-rust/starlark_syntax:starlark_syntax",
        "//third-party/rust:anyhow",
        "//third-party/rust:blake3",
        "//third-party/rust:bumpalo",
        "//third-party/rust:dashmap",
        "//third-party/rust:debugserver-types",
        "//third-party/rust:derivative",
        "//third-party/rust:derive_more",
        "//third-party/rust:either",
        "//third-party/rust:erased-serde",
        "//third-party/rust:hashbrown",
        "//third-party/rust:indexmap",
        "//third-party/rust:inventory",
        "//third-party/rust:itertools",
        "//third-party/rust:maplit",
        "//third-party/rust:num-bigint",
        "//third-party/rust:num-traits",
        "//third-party/rust:once_cell",
        "//third-party/rust:rand",
        "//third-party/rust:ref-cast",
        "//third-party/rust:regex",
        "//third-party/rust:rustyline",
        "//third-party/rust:serde",
        "//third-party/rust:serde_json",
        "//third-party/rust:stacker",
        "//third-party/rust:static_assertions",
        "//third-party/rust:strsim",
        "//third-party/rust:textwrap",
        "//third-party/rust:thiserror",
        "//third-party/rust:triomphe",
    ],
)
