load("//build_defs:proto.bzl", "proto_srcs", "rust_protobuf_library")

rust_protobuf_library(
    name = "buck2_cli_proto",
    srcs = glob(["src/**/*.rs"]),
    build_script = "build.rs",
    proto_srcs = ":buck2_cli_proto.proto",
    deps = [
        "//allocative/allocative:allocative",
        "//app/buck2_core:buck2_core",
        "//app/buck2_data:buck2_data",
        "//app/buck2_error:buck2_error",
        "//app/buck2_fs:buck2_fs",
        "//app/buck2_proto_serde:buck2_proto_serde",
        "//app/buck2_subscription_proto:buck2_subscription_proto",
        "//third-party/rust:bytes",
        "//third-party/rust:prost-types",
        "//third-party/rust:serde",
        "//third-party/rust:tokio-util",
    ],
)

proto_srcs(
    name = "buck2_cli_proto.proto",
    srcs = ["daemon.proto"],
    visibility = ["PUBLIC"],
    deps = [
        "//app/buck2_data:data_proto",
        "//app/buck2_subscription_proto:buck2_subscription_proto.proto",
    ],
)

export_file(
    name = "daemon.proto",
    visibility = ["PUBLIC"],
)
