load("//build_defs:rust.bzl", "rust_binary", "rust_library")
load(":transition.bzl", "buck2_client_transition_alias")

rust_library(
    name = "buck2",
    srcs = glob(["src/**/*.rs"]),
    rustc_flags = select({
        ":buck2_client_only_setting[build]": ["--cfg=client_only"],
        "DEFAULT": [],
    }),
    deps = [
        "//app/buck2_client:buck2_client",
        "//app/buck2_client_ctx:buck2_client_ctx",
        "//app/buck2_cmd_audit_client:buck2_cmd_audit_client",
        "//app/buck2_cmd_completion_client:buck2_cmd_completion_client",
        "//app/buck2_cmd_debug_client:buck2_cmd_debug_client",
        "//app/buck2_cmd_docs_client:buck2_cmd_docs_client",
        "//app/buck2_cmd_log_client:buck2_cmd_log_client",
        "//app/buck2_cmd_starlark_client:buck2_cmd_starlark_client",
        "//app/buck2_common:buck2_common",
        "//app/buck2_core:buck2_core",
        "//app/buck2_data:buck2_data",
        "//app/buck2_error:buck2_error",
        "//app/buck2_event_observer:buck2_event_observer",
        "//app/buck2_events:buck2_events",
        "//app/buck2_fs:buck2_fs",
        "//app/buck2_util:buck2_util",
        "//app/buck2_wrapper_common:buck2_wrapper_common",
        "//gazebo/dupe:dupe",
        "//superconsole:superconsole",
        "//third-party/rust:clap",
        "//third-party/rust:tokio",
        "//third-party/rust:tracing",
    ]
    + select({
        ":buck2_client_only_setting[build]": [],
        "DEFAULT": [
            "//app/buck2_daemon:buck2_daemon",
            "//app/buck2_server:buck2_server",
            "//app/buck2_test_runner:buck2_test_runner",
        ],
    })
    + select({
        "DEFAULT": [],
        "prelude//os:linux": [
            "//app/buck2_forkserver:buck2_forkserver",
            "//third-party/rust:dirs",
            "//third-party/rust:libc",
            "//third-party/rust:nix",
        ],
        "prelude//os:macos": [
            "//app/buck2_forkserver:buck2_forkserver",
            "//third-party/rust:dirs",
            "//third-party/rust:libc",
            "//third-party/rust:nix",
        ],
        "prelude//os:windows": [
            "//third-party/rust:windows-sys",
        ],
    }),
)

rust_binary(
    name = "buck2-bin",
    srcs = ["bin/buck2.rs"],
    allow_cache_upload = True,
    crate = "buck2",
    crate_root = "bin/buck2.rs",
    env = {
        # `-c buck.set_explicit_version=<version>` sets the version that `--version` prints.
        "YAK_SET_EXPLICIT_VERSION": read_config("buck", "set_explicit_version", ""),
    },
    # `-c yak.emit_relocs=true` keeps ELF relocations in the binary for BOLT.
    linker_flags = ["-Wl,--emit-relocs"] if read_config("yak", "emit_relocs", "") == "true" else [],
    rustc_flags = select({
        ":buck2_client_only_setting[build]": ["--cfg=client_only"],
        "DEFAULT": [],
    }),
    deps = [
        "//app/buck2:buck2",
        "//app/buck2_build_info:buck2_build_info",
        "//app/buck2_certs:buck2_certs",
        "//app/buck2_client_ctx:buck2_client_ctx",
        "//app/buck2_core:buck2_core",
        "//app/buck2_error:buck2_error",
        "//app/buck2_events:buck2_events",
        "//app/buck2_fs:buck2_fs",
        "//app/buck2_wrapper_common:buck2_wrapper_common",
        "//gazebo/dupe:dupe",
        "//superconsole:superconsole",
        "//third-party/rust:tracing",
    ]
    + select({
        "DEFAULT": [],
        "prelude//os:windows": [
            "//third-party/rust:mimalloc",
        ],
    })
    + select({
        ":buck2_client_only_setting[build]": [],
        "DEFAULT": [
            "//app/buck2_action_impl:buck2_action_impl",
            "//app/buck2_analysis:buck2_analysis",
            "//app/buck2_anon_target:buck2_anon_target",
            "//app/buck2_build_api:buck2_build_api",
            "//app/buck2_build_signals_impl:buck2_build_signals_impl",
            "//app/buck2_bxl:buck2_bxl",
            "//app/buck2_cfg_constructor:buck2_cfg_constructor",
            "//app/buck2_cmd_audit_server:buck2_cmd_audit_server",
            "//app/buck2_cmd_docs_server:buck2_cmd_docs_server",
            "//app/buck2_cmd_query_server:buck2_cmd_query_server",
            "//app/buck2_cmd_starlark_server:buck2_cmd_starlark_server",
            "//app/buck2_cmd_targets_server:buck2_cmd_targets_server",
            "//app/buck2_configured:buck2_configured",
            "//app/buck2_external_cells:buck2_external_cells",
            "//app/buck2_interpreter_for_build:buck2_interpreter_for_build",
            "//app/buck2_query_impls:buck2_query_impls",
            "//app/buck2_server_commands:buck2_server_commands",
            "//app/buck2_test:buck2_test",
            "//app/buck2_transition:buck2_transition",
            "//app/buck2_validation:buck2_validation",
        ],
    }),
)

constraint(
    name = "buck2_client_only_setting",
    default = "unspecified",
    values = [
        "build",
        "unspecified",
    ],
    visibility = ["PUBLIC"],
)

buck2_client_transition_alias(
    name = "buck2_client-bin",
    actual = ":buck2-bin",
    visibility = ["PUBLIC"],
)
