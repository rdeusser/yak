load("@crates//:workspace.bzl", "cargo_package")

cargo_package(include = [
    "//app/yak_host_sharing_proto:proto",
])

# The build scripts of other protobuf crates import these files.
filegroup(
    name = "proto",
    srcs = ["data.proto", "error.proto"],
    visibility = [
        "//app/yak_cli_proto:",
        "//app/yak_forkserver_proto:",
        "//app/yak_test_proto:",
        "//app/yak_worker_proto:",
    ],
)
