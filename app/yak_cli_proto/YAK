load("//build_defs:proto.bzl", "proto_srcs", "rust_protobuf_library")

rust_protobuf_library(
    name = "yak_cli_proto",
    srcs = glob(["src/**/*.rs"]),
    build_script = "build.rs",
    proto_srcs = ":yak_cli_proto.proto",
    deps = [
        "//allocative/allocative:allocative",
        "//app/yak_core:yak_core",
        "//app/yak_data:yak_data",
        "//app/yak_error:yak_error",
        "//app/yak_fs:yak_fs",
        "//app/yak_proto_serde:yak_proto_serde",
        "//app/yak_subscription_proto:yak_subscription_proto",
        "//third-party/rust:bytes",
        "//third-party/rust:prost-types",
        "//third-party/rust:serde",
        "//third-party/rust:tokio-util",
    ],
)

proto_srcs(
    name = "yak_cli_proto.proto",
    srcs = ["daemon.proto"],
    visibility = ["PUBLIC"],
    deps = [
        "//app/yak_data:data_proto",
        "//app/yak_subscription_proto:yak_subscription_proto.proto",
    ],
)

export_file(
    name = "daemon.proto",
    visibility = ["PUBLIC"],
)
