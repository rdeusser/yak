load("//build_defs:rust.bzl", "rust_library")

rust_library(
    name = "buck2_forkserver",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    compatible_with = [
        "prelude//os:linux",
        "prelude//os:macos",
    ],
    deps = [
        "//allocative/allocative:allocative",
        "//app/buck2_common:buck2_common",
        "//app/buck2_core:buck2_core",
        "//app/buck2_data:buck2_data",
        "//app/buck2_error:buck2_error",
        "//app/buck2_execute_local:buck2_execute_local",
        "//app/buck2_forkserver_proto:buck2_forkserver_proto",
        "//app/buck2_fs:buck2_fs",
        "//app/buck2_grpc:buck2_grpc",
        "//app/buck2_resource_control:buck2_resource_control",
        "//app/buck2_util:buck2_util",
        "//gazebo/dupe:dupe",
        "//third-party/rust:arc-swap",
        "//third-party/rust:async-trait",
        "//third-party/rust:futures",
        "//third-party/rust:libc",
        "//third-party/rust:rand",
        "//third-party/rust:tokio",
        "//third-party/rust:tokio-stream",
        "//third-party/rust:tonic",
    ] + select({
        "DEFAULT": [],
        "prelude//os:linux": [
            "//app/buck2_embedded_section:buck2_embedded_section",
            "//third-party/rust:nix",
        ],
    }),
)
