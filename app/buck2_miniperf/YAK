load("//build_defs:rust.bzl", "rust_binary", "rust_library")

rust_binary(
    name = "buck2_miniperf",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    allow_cache_upload = True,
    # Must be statically linked because the binary is embedded in the forkserver
    # and written to disk without its shared library dependencies.
    link_style = "static",
    deps = [
        "//third-party/rust:anyhow",
    ] + select({
        "DEFAULT": [],
        "prelude//os:linux": [
            "//app/buck2_miniperf_proto:buck2_miniperf_proto",
            "//third-party/rust:bincode",
            "//third-party/rust:perf-event",
            "//third-party/rust:smallvec",
            "//third-party/rust:thiserror",
        ],
    }),
)

