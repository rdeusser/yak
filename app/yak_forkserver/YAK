load("//build_defs:rust.bzl", "rust_library")

rust_library(
    name = "yak_forkserver",
    srcs = glob(
        ["src/**/*.rs"],
    ),
    compatible_with = [
        "prelude//os:linux",
        "prelude//os:macos",
    ],
    deps = [
        "//allocative/allocative:allocative",
        "//app/yak_common:yak_common",
        "//app/yak_core:yak_core",
        "//app/yak_data:yak_data",
        "//app/yak_error:yak_error",
        "//app/yak_execute_local:yak_execute_local",
        "//app/yak_forkserver_proto:yak_forkserver_proto",
        "//app/yak_fs:yak_fs",
        "//app/yak_grpc:yak_grpc",
        "//app/yak_resource_control:yak_resource_control",
        "//app/yak_util:yak_util",
        "//gazebo/dupe:dupe",
        "//third-party/rust:arc-swap",
        "//third-party/rust:async-trait",
        "//third-party/rust:futures",
        "//third-party/rust:libc",
        "//third-party/rust:rand",
        "//third-party/rust:tokio",
        "//third-party/rust:tokio-stream",
        "//third-party/rust:tonic",
    ] + select({
        "DEFAULT": [],
        "prelude//os:linux": [
            "//app/yak_embedded_section:yak_embedded_section",
            "//third-party/rust:nix",
        ],
    }),
)
