load("@crates//:workspace.bzl", "cargo_package")

cargo_package()

# The client-only binary, which `//:yak_bundle` and `yak.py` put next to the
# daemon binary, and whose dependencies `//app_dep_graph_rules` checks. It
# compiles the `yak` crate with `--cfg client_only` and without the daemon and
# server crates. Cargo has no build of it, because a Cargo package builds with
# one set of dependencies, so these targets are written by hand. Their
# dependencies are those of `Cargo.toml` without the server crates. The
# `--cfg tokio_unstable` flag repeats `.cargo/config.toml`, and the other flags
# and the binary's transition repeat `[profile.dev]` of `Cargo.toml`, with
# `opt-level = 1` and `panic = "abort"`. A crate with several versions in
# `Cargo.lock`, such as `nix`, is named with the version that the `yak` package
# resolves.
_CLIENT_ONLY_RUSTC_FLAGS = [
    "--cfg=client_only",
    "-Copt-level=1",
    "-Cdebuginfo=2",
    "-Cdebug-assertions=on",
    "-Coverflow-checks=on",
    "--cfg=tokio_unstable",
] + select({
    "DEFAULT": [],
    "prelude//rust/panic:panic[abort]": ["-Cpanic=abort"],
})

rust_library(
    name = "yak_client-lib",
    srcs = glob(["src/**/*.rs"]),
    crate = "yak",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = _CLIENT_ONLY_RUSTC_FLAGS,
    deps = [
        "crates//:clap",
        "crates//:tokio",
        "crates//:tracing",
        "//app/yak_client:yak_client",
        "//app/yak_client_ctx:yak_client_ctx",
        "//app/yak_cmd_audit_client:yak_cmd_audit_client",
        "//app/yak_cmd_completion_client:yak_cmd_completion_client",
        "//app/yak_cmd_debug_client:yak_cmd_debug_client",
        "//app/yak_cmd_docs_client:yak_cmd_docs_client",
        "//app/yak_cmd_log_client:yak_cmd_log_client",
        "//app/yak_cmd_starlark_client:yak_cmd_starlark_client",
        "//app/yak_common:yak_common",
        "//app/yak_core:yak_core",
        "//app/yak_data:yak_data",
        "//app/yak_error:yak_error",
        "//app/yak_event_observer:yak_event_observer",
        "//app/yak_events:yak_events",
        "//app/yak_fs:yak_fs",
        "//app/yak_util:yak_util",
        "//app/yak_wrapper_common:yak_wrapper_common",
        "//gazebo/dupe:dupe",
        "//superconsole:superconsole",
    ] + select({
        "DEFAULT": [],
        "prelude//os:linux": [
            "crates//:dirs",
            "crates//:libc",
            "crates//:nix-0.31.3",
            "//app/yak_forkserver:yak_forkserver",
        ],
        "prelude//os:macos": [
            "crates//:dirs",
            "crates//:libc",
            "crates//:nix-0.31.3",
            "//app/yak_forkserver:yak_forkserver",
        ],
        "prelude//os:windows": [
            "crates//:windows-sys-0.61.2",
        ],
    }),
)

rust_binary(
    name = "yak_client-bin",
    srcs = ["bin/yak.rs"],
    crate = "yak",
    crate_root = "bin/yak.rs",
    edition = "2024",
    rustc_flags = _CLIENT_ONLY_RUSTC_FLAGS,
    incoming_transition = "prelude//rust/panic:panic_transition[abort]",
    deps = [
        ":yak_client-lib",
        "crates//:tracing",
        "//app/yak_build_info:yak_build_info",
        "//app/yak_certs:yak_certs",
        "//app/yak_client_ctx:yak_client_ctx",
        "//app/yak_core:yak_core",
        "//app/yak_error:yak_error",
        "//app/yak_events:yak_events",
        "//app/yak_fs:yak_fs",
        "//app/yak_wrapper_common:yak_wrapper_common",
        "//gazebo/dupe:dupe",
        "//superconsole:superconsole",
    ] + select({
        "DEFAULT": [],
        "prelude//os:linux": ["crates//:tikv-jemallocator"],
        "prelude//os:macos": ["crates//:tikv-jemallocator"],
        "prelude//os:windows": ["crates//:mimalloc"],
    }),
    visibility = ["PUBLIC"],
)
