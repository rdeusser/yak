load(":defs.bzl", "execution_platforms")

execution_platforms(
    name = "default",
    visibility = ["PUBLIC"],
)

platform(
    name = "windows_debug",
    constraint_values = [
        "config//os/constraints:windows",
        "root//yak_utils/configuration:configuration[debug]",
    ],
)

platform(
    name = "windows_release",
    constraint_values = [
        "config//os/constraints:windows",
        "root//yak_utils/configuration:configuration[release]",
    ],
)

platform(
    name = "linux_debug",
    constraint_values = [
        "config//os/constraints:linux",
        "root//yak_utils/configuration:configuration[debug]",
    ],
)

platform(
    name = "linux_release",
    constraint_values = [
        "config//os/constraints:linux",
        "root//yak_utils/configuration:configuration[release]",
    ],
)
