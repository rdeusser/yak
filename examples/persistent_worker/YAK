load("defs.bzl", "demo", "worker")

python_binary(
    name = "one_shot",
    main = "one_shot.py",
)

python_binary(
    name = "worker_py",
    main = "persistent_worker.py",
    deps = [
        "//proto/bazel:worker_protocol_pb2",
        "//proto/yak_worker:worker_pb2",
    ],
)

worker(
    name = "worker",
    visibility = ["PUBLIC"],
    worker = ":worker_py",
)

[demo(name = "demo-" + str(i)) for i in range(4)]

# Type checks the scripts through the `[typecheck]` sub-target, which exists only when the Python
# toolchain sets `type_checker`. This example's toolchain does not set it.
python_library(
    name = "scripts-typing",
    srcs = [
        "one_shot.py",
        "persistent_worker.py",
    ],
    typing = True,
)
